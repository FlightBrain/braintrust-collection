# Copy this file to .env.local for local development.
# All NEXT_PUBLIC_* vars are exposed to the browser.

# === Chain ===
# Base mainnet = 8453, Base Sepolia = 84532, Ethereum mainnet = 1
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_CHAIN_NAME=Base

# RPC endpoint. Public RPC works for dev. For production, use Alchemy/Infura/
# QuickNode etc. to avoid rate limits.
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org

# === Contract ===
# Set this once the contract is deployed. Leave blank to keep the mint UI in
# "contract not yet deployed" state.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Collection size. Used for display + as fallback when contract reads fail.
NEXT_PUBLIC_TOTAL_SUPPLY=15

# Mint price in ETH (string). Used for display + transaction value when the
# contract does not expose price() or mintPrice() reads.
NEXT_PUBLIC_MINT_PRICE=

# === Marketplace ===
# Set once the collection is live on OpenSea / Magic Eden / etc.
NEXT_PUBLIC_MARKETPLACE_URL=

# === WalletConnect ===
# Get a project id at https://cloud.walletconnect.com (free)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# === Metadata (used by scripts/generate-metadata.ts) ===
# Once art is pinned to IPFS, change to ipfs://<cid> or your gateway.
NEXT_PUBLIC_BASE_IMAGE_URI=https://braintrust-collection.vercel.app
