# Copy this file to .env.local for local development.
# All NEXT_PUBLIC_* vars are exposed to the browser. NEVER put secrets here.

# ===========================================================================
# BASE SEPOLIA (testnet): use this configuration for testing
# ===========================================================================
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Paste the deployed thirdweb DropERC721 contract address here once deployed:
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Display fallbacks. The site reads live values from the contract when
# possible. These are only used if the contract reads fail.
NEXT_PUBLIC_TOTAL_SUPPLY=15
NEXT_PUBLIC_MINT_PRICE=0

# Marketplace link, leave empty until the collection is listed.
NEXT_PUBLIC_MARKETPLACE_URL=

# Reown/WalletConnect project ID. Public-safe (identifies the dApp, not the
# user). Override if you fork the project.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=1244257340c4eca87602fb431b8ec3a9

# Metadata generator base URL. For local/test, http URL is fine. Replace with
# ipfs://<cid> for mainnet.
NEXT_PUBLIC_BASE_IMAGE_URI=https://braintrust-collection.vercel.app

# Royalty settings (used by scripts/generate-collection-metadata.ts)
NEXT_PUBLIC_FEE_RECIPIENT=
NEXT_PUBLIC_SELLER_FEE_BPS=0

# ===========================================================================
# BASE MAINNET (production): DO NOT enable until testnet mint passes
# ===========================================================================
# NEXT_PUBLIC_CHAIN_ID=8453
# NEXT_PUBLIC_CHAIN_NAME=Base
# NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
# NEXT_PUBLIC_CONTRACT_ADDRESS=
# NEXT_PUBLIC_MINT_PRICE=0.005
# NEXT_PUBLIC_BASE_IMAGE_URI=ipfs://<art-cid>
# NEXT_PUBLIC_FEE_RECIPIENT=0x...
# NEXT_PUBLIC_SELLER_FEE_BPS=500
